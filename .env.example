# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TBF School Hub Remote Backend API URL
# Default documented endpoint: https://schubapi.thebarakafoundation.or.tz/api/docs
VITE_API_BASE_URL="https://schubapi.thebarakafoundation.or.tz/api/v1"
REMOTE_API_BASE="https://schubapi.thebarakafoundation.or.tz/api/v1"

# Google OAuth Credentials (optional for direct workspace integration)
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_REDIRECT_URI=""

# Real SMTP Email Configuration (optional fallback for transactional emails)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Direct Cellular SMS Gateway Configuration (Tanzania & International SMS)
# Option A: Beem Africa (https://beem.africa)
BEEM_API_KEY=""
BEEM_SECRET_KEY=""
BEEM_SENDER_ID="INFO"

# Option B: NextSMS (https://nextsms.co.tz)
NEXTSMS_USERNAME=""
NEXTSMS_PASSWORD=""
NEXTSMS_SENDER_ID="NEXTSMS"

# Option C: Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
